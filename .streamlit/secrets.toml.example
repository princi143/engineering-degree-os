# Copy this file to .streamlit/secrets.toml for LOCAL testing only.
# On Streamlit Community Cloud paste the same lines into App settings -> Secrets.
# NEVER commit the real secrets.toml to GitHub.
GEMINI_API_KEY = "paste-your-google-ai-studio-key-here"
