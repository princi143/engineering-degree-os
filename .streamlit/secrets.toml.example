# Copy this file to .streamlit/secrets.toml for LOCAL use only.
# On Streamlit Community Cloud paste the same lines into App settings -> Secrets.
# NEVER commit the real secrets.toml to GitHub (it is in .gitignore).

# --- Supabase (Cloud Feedback page) ---
# Project URL + PUBLISHABLE key (starts with sb_publishable_). Never use a secret / service_role key here.
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_REPLACE_WITH_YOUR_KEY"

# --- Gemini (Ask Degree AI page, optional) ---
# GEMINI_API_KEY = "paste-your-google-ai-studio-key-here"   # or use Ask Degree AI -> Connect Gemini
# GEMINI_MODEL = "gemini-2.5-flash"
